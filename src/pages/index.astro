---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profilePhoto from '../../my-pic-for-display.jpg';
import qardyImage from '../../qardy-products/1-qardy-revamped-website.png';
import diagnostixImage from '../../3d-diagnostix-products/chart.png';
import eradaImage from '../../erada-finance-products/xfin-mvp/2-xfin-mvp-create-company-lead.png';
import qardyLogo from '../../qardy-products/qardy-logo.png';
import diagnostixLogo from '../../3d-diagnostix-products/3D-Diagnostix-logo.png';
import eradaLogo from '../../erada-finance-products/erada-logo.png';
import { professionalCertifications, coursesAndTraining } from '../data/certifications';

const snapshots = (await getCollection('snapshots')).sort(
	(a, b) => b.data.order - a.data.order
);
const experience = (await getCollection('experience')).sort(
	(a, b) => a.data.order - b.data.order
);

const snapshotImages: Record<string, ImageMetadata> = {
	Qardy: qardyImage,
	'3D|Diagnostix': diagnostixImage,
	'Erada Finance': eradaImage,
};

const companyLogos: Record<string, ImageMetadata> = {
	Qardy: qardyLogo,
	'3D|Diagnostix': diagnostixLogo,
	'Erada Finance': eradaLogo,
};
---

<Layout>
	<section id="hero" class="mx-auto max-w-5xl px-6 py-20 md:py-28">
		<div class="flex flex-col items-center gap-10 text-center md:flex-row md:items-center md:gap-14 md:text-left">
			<Image
				src={profilePhoto}
				alt="Portrait of Abdelrahman Ghanem"
				width={480}
				height={480}
				class="h-40 w-40 shrink-0 rounded-full object-cover shadow-lg ring-4 ring-primary/15 md:h-56 md:w-56"
			/>
			<div class="flex flex-col items-center gap-4 md:items-start">
				<div>
					<h1 class="font-heading text-4xl font-bold text-ink sm:text-5xl">
						Abdelrahman Ghanem
					</h1>
					<p class="mt-2 text-lg font-semibold text-primary">Product Manager</p>
					<span class="mt-2 inline-block rounded-full border border-border bg-surface px-3 py-1 text-xs font-semibold uppercase tracking-wide text-ink-muted">
						FinTech &amp; HealthTech
					</span>
				</div>
				<p class="max-w-xl text-base leading-relaxed text-ink-muted">
					Growth-oriented Product Manager with 4+ years of progressive experience in product
					management and a strong track record of launching new product lines across FinTech
					&amp; HealthTech industries, adept at spearheading development strategies and
					maximizing value through user-centric techniques and innovative solutions with proven
					insights.
				</p>
				<div class="flex flex-wrap items-center justify-center gap-3 md:justify-start">
					<a
						href="#snapshots"
						class="rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-ink transition hover:opacity-90"
					>
						View my work
					</a>
					<a
						href="https://www.linkedin.com/in/abdelrahman-kamel-ghanem16"
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-lg border border-border px-5 py-2.5 text-sm font-semibold text-ink transition hover:bg-surface"
					>
						LinkedIn
					</a>
				</div>
			</div>
		</div>
	</section>

	<section id="experience" class="mx-auto max-w-5xl px-6 py-16">
		<h2 class="font-heading text-2xl font-bold text-ink">Experience</h2>
		<ol class="relative mt-8 ml-3 border-l-2 border-border">
			{experience.map((role) => (
				<li class="relative pb-10 pl-8 last:pb-0">
					<span class="absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-bg bg-primary"></span>
					<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
						<h3 class="font-heading text-base font-bold text-ink">{role.data.title}</h3>
						<span class="text-xs font-semibold uppercase tracking-wide text-ink-muted">
							{role.data.startDate} &ndash; {role.data.endDate}
						</span>
					</div>
					<div class="mt-1 flex items-center gap-2">
						<Image
							src={companyLogos[role.data.company]}
							alt={`${role.data.company} logo`}
							width={160}
							class="h-5 w-auto rounded bg-white p-0.5 ring-1 ring-border"
						/>
						<p class="text-sm font-semibold text-primary">{role.data.company}</p>
					</div>
					<p class="mt-1 text-sm text-ink-muted">{role.data.summary}</p>
					<ul class="mt-2 list-disc space-y-1 pl-4 text-sm text-ink-muted marker:text-border">
						{role.data.highlights.map((point) => (
							<li>{point}</li>
						))}
					</ul>
				</li>
			))}
		</ol>
	</section>

	<section id="snapshots" class="mx-auto max-w-5xl px-6 py-16">
		<h2 class="font-heading text-2xl font-bold text-ink">Snapshots</h2>
		<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{snapshots.map((snapshot) => (
				<article class="flex flex-col overflow-hidden rounded-xl border border-border bg-surface shadow-sm">
					<Image
						src={snapshotImages[snapshot.data.company]}
						alt={`${snapshot.data.company} product screenshot`}
						width={640}
						height={400}
						class="h-40 w-full border-b border-border object-cover object-top"
					/>
					<div class="flex flex-1 flex-col gap-4 p-6">
						<div>
							<h3 class="font-heading text-lg font-bold text-ink">{snapshot.data.company}</h3>
							<span class="mt-1 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
								{snapshot.data.role}
							</span>
						</div>
						<p class="text-sm leading-relaxed text-ink-muted">{snapshot.data.summary}</p>
						<div class="mt-auto grid grid-cols-3 gap-2 border-t border-border pt-4">
							{snapshot.data.metrics.slice(0, 3).map((metric) => (
								<div class="text-center">
									<div class="font-heading text-base font-bold text-primary">{metric.value}</div>
									<div class="text-[11px] uppercase tracking-wide text-ink-muted">{metric.label}</div>
								</div>
							))}
						</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<section id="accreditations" class="mx-auto max-w-5xl px-6 py-16">
		<h2 class="font-heading text-2xl font-bold text-ink">Certifications &amp; Accreditations</h2>

		<h3 class="mt-8 text-sm font-semibold uppercase tracking-wide text-ink-muted">
			Professional Certifications
		</h3>
		<div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
			{professionalCertifications.map((cert) => (
				<div class="rounded-lg border border-border bg-surface p-4">
					<div class="flex items-start justify-between gap-3">
						<h4 class="font-heading text-sm font-bold text-ink">{cert.name}</h4>
						<span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-ink-muted">
							{cert.date}
						</span>
					</div>
					<p class="mt-1 text-xs font-semibold text-primary">{cert.issuer}</p>
					{cert.detail && <p class="mt-1 text-xs text-ink-muted">{cert.detail}</p>}
				</div>
			))}
		</div>

		<h3 class="mt-10 text-sm font-semibold uppercase tracking-wide text-ink-muted">
			Courses &amp; Training
		</h3>
		<ul class="mt-4 flex flex-wrap gap-2">
			{coursesAndTraining.map((course) => (
				<li
					class="rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-medium text-ink"
					title={`${course.issuer} — ${course.date}`}
				>
					{course.name} <span class="text-ink-muted">&mdash; {course.issuer}</span>
				</li>
			))}
		</ul>
	</section>
</Layout>
