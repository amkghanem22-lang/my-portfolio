---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Abdelrahman Ghanem — Product Manager',
	description = "Product Manager with 4+ years launching FinTech & HealthTech products — from PRDs and roadmaps to measurable outcomes across XFin, Qardy, and 3D|Diagnostix.",
} = Astro.props;

const navLinks = [
	{ label: 'About', href: '#hero' },
	{ label: 'Experience', href: '#experience' },
	{ label: 'Snapshots', href: '#snapshots' },
	{ label: 'Certifications', href: '#accreditations' },
	{ label: 'Contact', href: '#contact' },
];

const pageUrl = Astro.url.toString();
const ogImageUrl = new URL('/og-image.jpg', Astro.url).toString();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Abdelrahman Ghanem" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
	</head>
	<body class="font-body">
		<header
			data-site-header
			class="sticky top-0 z-50 border-b border-border/0 bg-bg/90 backdrop-blur transition-shadow duration-200"
		>
			<nav class="mx-auto flex max-w-5xl flex-col items-center gap-2 px-6 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-0 sm:py-4">
				<a href="#" class="font-heading text-lg font-bold text-primary">
					Abdelrahman Ghanem
				</a>
				<ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-sm font-semibold text-ink-muted">
					{navLinks.map((link) => (
						<li>
							<a href={link.href} class="transition-colors hover:text-primary">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</header>

		<slot />

		<footer class="border-t border-border">
			<div class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-6 py-8 text-sm text-ink-muted sm:flex-row sm:justify-between">
				<p>&copy; {new Date().getFullYear()} Abdelrahman Ghanem</p>
				<div class="flex items-center gap-4">
					<a href="mailto:amkghanem22@gmail.com" class="transition-colors hover:text-primary">
						Email
					</a>
					<a
						href="https://www.linkedin.com/in/abdelrahman-kamel-ghanem16"
						target="_blank"
						rel="noopener noreferrer"
						class="transition-colors hover:text-primary"
					>
						LinkedIn
					</a>
				</div>
			</div>
		</footer>

		<script>
			const header = document.querySelector('[data-site-header]');
			const onScroll = () => {
				if (window.scrollY > 8) {
					header?.classList.add('shadow-md', 'border-border');
					header?.classList.remove('border-border/0');
				} else {
					header?.classList.remove('shadow-md', 'border-border');
					header?.classList.add('border-border/0');
				}
			};
			onScroll();
			window.addEventListener('scroll', onScroll, { passive: true });
		</script>
	</body>
</html>
